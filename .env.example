# Copier en .env pour le développement local (jamais commité, voir .gitignore).
# Sur Railway, ces valeurs sont des variables d'environnement du service (section 4 du plan).

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=              # signe le cookie de session
ALLOWED_EMAILS=              # liste séparée par des virgules
ADMIN_EMAILS=                # liste séparée par des virgules
CALENDAR_ID=                 # xxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON= # contenu du fichier JSON du compte de service, sur une ligne
LLM_API_KEY=
# LLM_MODELS, ex. gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite. Google retire les anciens
# modèles (404, ex. gemini-2.5-*) : vérifier chacun avec « Tester les modèles » sur la page admin.
LLM_MODELS=                  # modèles Gemini séparés par des virgules, du préféré au repli (l'ancien nom LLM_MODEL marche aussi)
TZ=Europe/Paris
VALIDATION_WEEKS=8
DATA_DIR=./data
